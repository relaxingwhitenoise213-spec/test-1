// Vocalis — production database schema.
//
// This schema models the full SaaS data layer (auth, generations, billing,
// usage, notifications). The running app persists history in the browser so it
// works with zero setup; wire these models to the API routes when you connect a
// PostgreSQL database. See README "Database" for setup steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication (NextAuth / Better Auth compatible)
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  generations   Generation[]
  apiKeys       ApiKey[]
  favorites     Favorite[]
  settings      Setting?
  usageLogs     UsageLog[]
  notifications Notification[]
  subscription  Subscription?
  invoices      Invoice[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// TTS domain
// ---------------------------------------------------------------------------

enum ProviderKey {
  WEB_SPEECH
  OPENAI
  ELEVENLABS
  GOOGLE
  AZURE
  POLLY
}

model Generation {
  id              String       @id @default(cuid())
  userId          String
  title           String
  text            String       @db.Text
  provider        ProviderKey
  voiceId         String
  voiceName       String
  language        String
  characters      Int
  durationSeconds Float        @default(0)
  settings        Json
  favorite        Boolean      @default(false)
  createdAt       DateTime     @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioFile AudioFile?

  @@index([userId, createdAt])
  @@index([provider])
}

model AudioFile {
  id           String     @id @default(cuid())
  generationId String     @unique
  url          String
  format       String
  sizeBytes    Int
  createdAt    DateTime   @default(now())

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  voiceId   String
  provider  ProviderKey
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, voiceId])
  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  provider   ProviderKey
  // Store only a hash of the secret; never the plaintext.
  hashedKey  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Setting {
  id             String      @id @default(cuid())
  userId         String      @unique
  theme          String      @default("system")
  locale         String      @default("en")
  defaultProvider ProviderKey @default(WEB_SPEECH)
  emailNotifications Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Usage, analytics & notifications
// ---------------------------------------------------------------------------

model UsageLog {
  id         String      @id @default(cuid())
  userId     String
  provider   ProviderKey
  characters Int
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  path      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

enum NotificationType {
  SUCCESS
  WARNING
  ERROR
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

enum PlanTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id              String   @id @default(cuid())
  userId          String
  stripeInvoiceId String?  @unique
  amountDue       Int
  currency        String   @default("usd")
  status          String
  hostedInvoiceUrl String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
